# Public URL the site is served from (used for metadata, sitemap and share images).
NEXT_PUBLIC_SITE_URL=https://wallet.amerox.io

# Chrome Web Store listing. Leave empty to use the published listing
# (https://chromewebstore.google.com/detail/canimdcopjlodioinbejamfelpijmblm).
NEXT_PUBLIC_CHROME_STORE_URL=

# Google Play listing. Leave empty to use the published listing
# (https://play.google.com/store/apps/details?id=io.amerox.wallet); set to "off" to hide
# every "Get it on Google Play" badge.
NEXT_PUBLIC_PLAY_STORE_URL=
